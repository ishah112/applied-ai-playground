# Copy to .env — never commit .env
POSTGRES_USER=playground
POSTGRES_PASSWORD=playground
POSTGRES_DB=playground
POSTGRES_PORT=5432
DATABASE_URL=postgresql://playground:playground@localhost:5432/playground

# LLM layer (optional for baseline). Leave blank to use the fake client in tests.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
